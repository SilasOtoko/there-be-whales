# ── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────
.next/
out/
build/
dist/
next-env.d.ts

# ── Environment variables / secrets ──────────
# Keeps API tokens (e.g. IUCN_API_TOKEN) out of the repo.
.env
.env*.local
.env.development
.env.production
# Commit a template with empty values so others know what's needed:
!.env.example

# ── Vercel ───────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────
*.tsbuildinfo

# ── Testing ──────────────────────────────────
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Logs & debug ─────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# ── Local data / API response caches ─────────
# Raw OBIS/GBIF dumps used while exploring the API can be huge.
/data/raw/
/.cache/
*.geojson.tmp

# ── Editors & OS ─────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# ── Misc ─────────────────────────────────────
*.pem
.eslintcache
.turbo
